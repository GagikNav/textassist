{
  "$comment": "Canonical, harness-agnostic configuration for the Text Assist agent workflow. Scripts read this; humans edit it. Keep it valid JSON (no comments except this key).",
  "repo": "GagikNav/textassist",
  "defaultBranch": "main",
  "maxDepth": 2,

  "project": {
    "owner": "GagikNav",
    "number": 4,
    "autoDetect": true,
    "statusField": "Status",
    "statusMap": {
      "agent:ready": "Ready",
      "agent:in-progress": "In Progress",
      "agent:blocked": "Backlog",
      "agent:review": "In Review",
      "agent:done": "Done"
    }
  },

  "build": {
    "command": "xcodebuild build -project TextAssist.xcodeproj -scheme \"Text Assist\" -configuration Debug -destination \"platform=macOS\" -derivedDataPath build/DerivedData",
    "mustPass": true
  },

  "protectedPaths": [
    "TextAssist.xcodeproj/project.pbxproj"
  ],

  "sequentialFiles": [
    "TextAssist/Core/SummarizationOrchestrator.swift"
  ],

  "labels": {
    "state": {
      "ready": "agent:ready",
      "inProgress": "agent:in-progress",
      "blocked": "agent:blocked",
      "review": "agent:review",
      "done": "agent:done"
    },
    "kind": { "epic": "kind:epic", "task": "kind:task" },
    "size": { "S": "size:S", "M": "size:M", "L": "size:L" },
    "area": ["models", "providers", "core", "stores", "ui", "utilities", "design"]
  },

  "milestones": {
    "M0": "M0 - Design approved",
    "M1": "M1 - Foundation",
    "M2": "M2 - Write + Replace",
    "M3": "M3 - Chat",
    "M4": "M4 - Menu bar status",
    "M5": "M5 - Polish (P1)"
  },

  "epics": {},
  "issues": {}
}
